      "configurable" : "N",
      "description" : "DatasourcePrescriptions",
      "query" : "select\n\tprescr_medica.nr_atendimento,\n\tatendimento_paciente.dt_alta,\n\ttasy.obter_nome_paciente(prescr_medica.nr_atendimento) nm_paciente,\n\tatend_categoria_convenio.cd_convenio,\n\tobter_desc_convenio(atend_categoria_convenio.cd_convenio) ds_convenio,\n\tprescr_medica.nr_prescricao,\n\tprescr_medica.dt_prescricao,\n\tprescr_medica.dt_liberacao dt_liberacao_prescr,\n\tprescr_medica.cd_setor_atendimento,\n\ttasy.obter_desc_setor_atend(prescr_medica.cd_setor_atendimento) ds_setor_atendimento,\n\tprescr_material.nr_sequencia nr_seq_material_prescr,\n\tprescr_material.cd_material,\n\tobter_desc_material(prescr_mat_hor.cd_material) ds_material,\n\tprescr_mat_hor.cd_unidade_medida cd_unid_med_prescr,\n\tprescr_mat_hor.qt_dispensar qt_item_prescr,\n\tprescr_mat_hor.ds_horario,\n\tprescr_mat_hor.nm_usuario_susp,\n\tap_lote.dt_atend_farmacia,\n\t(\tselect\tmax(prescr_mat_alteracao.dt_alteracao)\n\t\tfrom\tprescr_mat_alteracao\n\t\twhere\tprescr_mat_alteracao.nr_seq_horario = prescr_mat_hor.nr_sequencia\n\t\tand\t\tie_alteracao in (3, 22, 35, 45, 29460)\n\t) dt_checagem_enfermagem,\n\t(\tselect\tmax(prescr_mat_alteracao.nr_seq_motivo_susp)\n\t\tfrom\tprescr_mat_alteracao\n\t\twhere\tprescr_mat_alteracao.nr_seq_horario = prescr_mat_hor.nr_sequencia\n\t\tand\t\tie_alteracao in (1, 5, 9, 12, 13, 14, 23, 29, 30, 31, 65)\n\t) nr_seq_motivo_susp,\n\tap_lote.nr_sequencia nr_seq_ap_lote,\n\tmaterial_atend_paciente.nr_interno_conta,\n\tmaterial_atend_paciente.nr_sequencia nr_seq_material_atend_pac,\n\tcase\n\t\twhen (\n\t\t\tselect count(1)\n\t\t\tfrom auditoria_matpaci\n\t\t\twhere auditoria_matpaci.nr_seq_matpaci = material_atend_paciente.nr_sequencia\n\t\t) = 0\n\t\t\tthen 'Auditoria não gerada'\n\t\telse 'Auditoria gerada'\n\tend ie_auditoria_gerada\nfrom\tprescr_medica\njoin\tprescr_material on (prescr_material.nr_prescricao = prescr_medica.nr_prescricao)\njoin \tprescr_mat_hor on (prescr_mat_hor.nr_prescricao = prescr_medica.nr_prescricao and prescr_mat_hor.nr_seq_material = prescr_material.nr_sequencia)\njoin\tap_lote on (ap_lote.nr_sequencia = prescr_mat_hor.nr_seq_lote)\njoin\tmaterial_atend_paciente on (material_atend_paciente.nr_seq_mat_hor = prescr_mat_hor.nr_sequencia)\njoin\tatendimento_paciente on (atendimento_paciente.nr_atendimento = prescr_medica.nr_atendimento)\njoin\t(\n\tselect\t*\n\tfrom\tatend_categoria_convenio\n\twhere\tatend_categoria_convenio.nr_seq_interno in ( \n\t\tselect max(max_atend_categoria_convenio.nr_seq_interno)\n\t\tfrom\tatend_categoria_convenio max_atend_categoria_convenio\n\t\twhere\tmax_atend_categoria_convenio.nr_atendimento = atend_categoria_convenio.nr_atendimento\n)) \t\t\tatend_categoria_convenio on (atend_categoria_convenio.nr_atendimento = atendimento_paciente.nr_atendimento)\nwhere\ttasy.obter_dados_material(prescr_mat_hor.cd_material, 'CGRU') = 1\n@RESTRICAO\nand\t\trownum <= 100\norder by\n\tprescr_medica.nr_atendimento,\n\tprescr_medica.nr_prescricao"
    }
