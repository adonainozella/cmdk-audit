      "query" : "select\n\ttasy.obter_nome_paciente(prescr_medica.nr_atendimento) nm_paciente,\n\tprescr_medica.nr_atendimento,\n\tprescr_medica.nr_prescricao,\n\tprescr_medica.cd_setor_atendimento,\n\ttasy.obter_desc_setor_atend(prescr_medica.cd_setor_atendimento) ds_setor_atendimento,\n\tprescr_medica.dt_prescricao,\n\tprescr_medica.dt_liberacao dt_liberacao_prescr,\n\tmaterial_atend_paciente.nr_interno_conta,\n\tprescr_mat_hor.cd_material,\n\tobter_desc_material(prescr_mat_hor.cd_material) ds_material,\n\tprescr_mat_hor.cd_unidade_medida cd_unid_med_prescr,\n\tprescr_mat_hor.qt_dispensar qt_item_prescr,\n\tprescr_mat_hor.ds_horario,\n\tprescr_mat_hor.nm_usuario_susp,\n\tap_lote.dt_atend_farmacia,\n\tdt_alteracao dt_checagem_enf,\n\tprescr_mat_alteracao.nr_seq_motivo_susp,\n\tap_lote.nr_sequencia nr_seq_ap_lote,\n\tmaterial_atend_paciente.nr_sequencia nr_seq_material_atend_pac,\n\tcase\n\t\twhen (\n\t\t\tselect count(1)\n\t\t\tfrom auditoria_matpaci\n\t\t\twhere auditoria_matpaci.nr_seq_matpaci = material_atend_paciente.nr_sequencia\n\t\t) = 0\n\t\t\tthen 'Auditoria não gerada'\n\t\telse 'Auditoria gerada'\n\tend ie_auditoria_gerada\nfrom\t\tprescr_medica\njoin \t\tprescr_mat_hor on (prescr_mat_hor.nr_prescricao = prescr_medica.nr_prescricao)\njoin\t\tap_lote on (ap_lote.nr_sequencia = prescr_mat_hor.nr_seq_lote)\njoin\tmaterial_atend_paciente on (material_atend_paciente.nr_seq_mat_hor = prescr_mat_hor.nr_sequencia)\nleft join\tprescr_mat_alteracao on (prescr_mat_alteracao.nr_seq_horario = prescr_mat_hor.nr_sequencia)\nwhere\ttasy.obter_dados_material(prescr_mat_hor.cd_material, 'CGRU') = 1\n--and\t\tnot exists (select 1 from auditoria_matpaci where auditoria_matpaci.nr_seq_matpaci = material_atend_paciente.nr_sequencia)\n@RESTRICAO\nand\t\trownum <= 100\norder by\n\tprescr_medica.nr_atendimento,\n\tprescr_medica.nr_prescricao"
